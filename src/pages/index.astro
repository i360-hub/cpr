---
// Homepage (/) — also the Fort Mill water damage page. On 2026-09-13 the old
// Fort Mill city page was merged in here (worker.js redirects its URL to /):
// Google had already chosen / for the Fort Mill queries and the
// two URLs were splitting them. Its local content (neighborhoods, local causes,
// Fort Mill FAQs) lives on this page now — keep it Fort Mill-first, and mention
// Charlotte only as a geographic reference point.
// Section order: Hero → Urgency → Fort Mill local content → Neighborhoods →
// Timeline → Process → Fort Mill neighborhood problems → Services → Reviews →
// Differentiators → Insurance → FAQ → ServiceArea → FinalCTA → Contact.
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/widgets/Hero.astro";
import UrgencyBand from "@components/widgets/UrgencyBand.astro";
import LocalContent from "@components/widgets/LocalContent.astro";
import Neighborhoods from "@components/widgets/Neighborhoods.astro";
import Timeline from "@components/widgets/Timeline.astro";
import ProcessSteps from "@components/widgets/ProcessSteps.astro";
import ServicesGrid from "@components/widgets/ServicesGrid.astro";
import Reviews from "@components/widgets/Reviews.astro";
import { featuredReviews } from "@data/reviews";
import imgThermal from "@assets/images/organic/thermal-imaging.jpg";
import Differentiators from "@components/widgets/Differentiators.astro";
import InsuranceCard from "@components/widgets/InsuranceCard.astro";
import Faq from "@components/widgets/Faq.astro";
import ServiceArea from "@components/widgets/ServiceArea.astro";
import FinalCta from "@components/widgets/FinalCta.astro";
import ContactForm from "@components/widgets/ContactForm.astro";
import ActionShot from "@components/widgets/ActionShot.astro";
import { homepage } from "@data/services";
import { heroPreload } from "@lib/images";
import heroImg from "@assets/images/hero-home.webp";
import imgCrew from "@assets/images/organic/cpr-technician.jpg";
import { waterCta } from "@data/ctaCopy";

const faq = [
  { q: "How fast can you get to my house in Fort Mill?", a: 'Our crew is typically at your door in 25 to 35 minutes. Our shop is at 3650 Centre Circle in Fort Mill, and we answer the phone 24 hours a day, 7 days a week. Outside Fort Mill, our goal is 60 minutes or less anywhere in our service area. See our <a href="/service-areas">service area pages</a> for your town, or call <a href="tel:9802773700">980-277-3700</a> any time.' },
  { q: "My home in Baxter Village has Dura-PEX plumbing. Should I be worried?", a: "Yes — Dura-PEX fittings installed between 2001 and 2008 are known to develop pinhole leaks. Watch for low water pressure, warm spots on walls, or a spike in your water bill. If a fitting fails, shut off your main valve and call us immediately. We can extract the water, dry the structure, and rebuild the damaged areas." },
  { q: "Does Fort Mill flood during heavy rain?", a: 'Parts of Fort Mill do, especially near Sugar Creek and its tributaries. York County gets about 44 inches of rain a year, and its clay-heavy soil does not drain well, so water pools around foundations and seeps into crawlspaces and basements. Low-lying neighborhoods near downtown and along creek corridors carry the highest risk, and Hurricane Helene in 2024 caused significant crawlspace flooding in several of them. <a href="/basement-flooding">See our basement and crawlspace flooding services.</a>' },
  { q: "Will mold grow after water damage in my Fort Mill home?", a: 'Mold can start growing within 48 hours in Fort Mill\'s humid climate, especially in crawlspaces over York County\'s clay soil. That is why fast water removal and professional drying are critical. We treat surfaces with antimicrobial solution during every job. If mold is already present, we contain the area, remove it safely, and clean the air with HEPA scrubbers. <a href="/mold-removal">Learn more about our mold removal process.</a>' },
  { q: "What should I do right now if a pipe bursts or my house is flooding?", a: "First, find your main water shut-off valve and turn off the water. If it is safe, turn off electricity to the wet rooms at the breaker box. Do not walk through standing water near electrical outlets. Then call us right away at (980) 277-3700. We will dispatch a crew immediately." },
  { q: "Do you handle the rebuild after water damage, or just the drying?", a: "We handle both, with our own crew. We do the emergency water removal, structural drying, and daily moisture monitoring. Most homes take 3 to 5 days of monitored drying, and we do not stop until the structure is verified dry. Then the same team rebuilds everything we removed: drywall, paint, trim, cabinets, flooring, and subfloors. One project manager runs the whole job, so you never have to juggle separate contractors." },
  { q: "Will my insurance cover water damage from a burst pipe in Fort Mill?", a: 'In most cases, yes. Homeowners insurance typically covers water damage from sudden and accidental events like burst pipes, supply line failures, and appliance leaks. Flood damage from rising water usually requires a separate flood policy. We write the estimate in Xactimate, document everything with photos and daily moisture readings, and bill your insurance directly, so on covered work you pay your deductible and nothing beyond it. <a href="/water-damage-restoration">See how we handle the insurance process.</a>' },
  { q: "How much does water damage restoration cost?", a: "The cost depends on the size of the affected area, the type of water, and how much material needs to be removed and rebuilt. We provide an on-site assessment and handle the insurance paperwork for you." },
];

// Fort Mill local content, carried over from the retired Fort Mill page.
const fortMillIntro = [
  { tag: "h2", html: "24/7 Water Damage Restoration in Fort Mill, SC" },
  { tag: "p", html: 'Got water where it shouldn\'t be? We\'re <a href="/about-carolina-pro-restoration">Carolina Pro Restoration</a>, and our shop is at 3650 Centre Circle in Fort Mill, about 25 to 35 minutes from anywhere in town. Our crew shows up with truck-mounted extractors, commercial dehumidifiers, and FLIR thermal imaging cameras — everything needed to stop the damage and start drying your home the same hour you call. We answer 24/7, holidays included — call <a href="tel:9802773700">980-277-3700</a>.' },
  { tag: "p", html: 'Fort Mill sits in York County, South Carolina, where homes deal with around 44 inches of rain per year. That\'s more than the national average, and it keeps our phones ringing. We handle <a href="/burst-pipe-repair">burst pipes</a>, hot water heater failures, washing machine overflows, toilet supply line breaks, <a href="/sewage-cleanup">sewage backups</a>, and storm flooding throughout Fort Mill and nearby <a href="/water-damage-restoration-tega-cay-sc">Tega Cay</a>, <a href="/water-damage-restoration-indian-land-sc">Indian Land</a>, and <a href="/water-damage-restoration-rock-hill-sc">Rock Hill</a>.' },
  { tag: "h3", html: "Why Fort Mill Homes Are at Risk" },
  { tag: "p", html: "Many Fort Mill neighborhoods were built in the early 2000s during the housing boom. Subdivisions like Baxter Village, Regent Park, and Springfield used Dura-PEX plumbing that has a history of pinhole leaks and fitting failures after 15 to 20 years. If your home was built between 2001 and 2010, your plumbing is entering the failure window right now. We see multiple calls per month from these neighborhoods for supply line failures behind walls and under slab foundations." },
  { tag: "p", html: "Fort Mill also sits near Sugar Creek and tributary streams that rise fast during heavy rain events. Hurricane Helene in 2024 pushed water into homes along low-lying streets and caused significant crawlspace flooding in older neighborhoods closer to downtown. The clay-heavy soil in York County doesn't drain well, which means even moderate rain can pool around foundations and seep into basements and crawlspaces." },
];

const fortMillProblems = [
  { tag: "h2", html: "Common Water Damage Problems in Fort Mill Neighborhoods" },
  { tag: "h3", html: "Baxter Village — Dura-PEX Plumbing Failures" },
  { tag: "p", html: 'Baxter Village was built between 2001 and 2008. Homeowners here frequently call us for Dura-PEX fitting leaks behind walls that went unnoticed for days. If you see a drop in water pressure or a warm spot on a wall, call us at <a href="tel:9802773700">980-277-3700</a> before the damage spreads into the subfloor.' },
  { tag: "h3", html: "Regent Park & Springfield — Crawlspace Moisture" },
  { tag: "p", html: 'Homes in Regent Park and Springfield sit on crawlspace foundations over York County\'s red clay soil. After heavy rain, that clay holds water against the foundation for days. We regularly pull wet insulation out of crawlspaces in these neighborhoods and handle the <a href="/mold-removal-fort-mill-sc">mold remediation in Fort Mill</a> that follows when moisture sits too long. If you smell must or dampness in your home, there\'s a good chance moisture is building underneath. Our team uses thermal imaging to check without tearing anything out.' },
  { tag: "h3", html: "Downtown Fort Mill — Aging Pipes in Pre-2000 Homes" },
  { tag: "p", html: "Homes closer to downtown Fort Mill were built in the 1960s through 1990s with galvanized steel or copper plumbing that corrodes from the inside over time. We see burst pipes, slow slab leaks, and water heater failures in this area regularly. Rusty water when you first turn on the faucet is the warning sign. If a pipe lets go, shut off your main valve and call us immediately — we can be there in 25 to 35 minutes." },
  { tag: "h3", html: "Sewage Backups & Basement Flooding in Fort Mill" },
  { tag: "p", html: 'When a sewer line backs up or a septic system fails, that\'s a Category 3 event — contaminated water that needs protective gear, not a mop. Our <a href="/sewage-cleanup">sewage cleanup</a> crew extracts it, removes anything porous it touched, and disinfects before drying. We also handle <a href="/basement-flooding">basement flood cleanup</a> across Fort Mill, from finished basements that take on water during storms to crawlspaces that fill once the clay soil stops draining.' },
];

const fortMillNeighborhoods = ["Baxter Village", "Regent Park", "Springfield", "Kingsley", "Massey", "Catawba Plantation", "Sutton Hall", "Downtown Fort Mill"];

// Nearby town pages. Fort Mill is this page; Charlotte stays in the footer list.
const homeCities = [
  { label: "Tega Cay, SC", href: "/water-damage-restoration-tega-cay-sc" },
  { label: "Rock Hill, SC", href: "/water-damage-restoration-rock-hill-sc" },
  { label: "Indian Land, SC", href: "/water-damage-restoration-indian-land-sc" },
  { label: "Lake Wylie, SC", href: "/water-damage-restoration-lake-wylie-sc" },
  { label: "Clover, SC", href: "/water-damage-restoration-clover-sc" },
  { label: "York, SC", href: "/water-damage-restoration-york-sc" },
  { label: "Pineville, NC", href: "/water-damage-restoration-pineville-nc" },
  { label: "Ballantyne, NC", href: "/water-damage-restoration-ballantyne-nc" },
];

const processSteps = [
  { title: "You Call, We Dispatch", text: "Call our 24/7 line and a local crew heads to your property right away. In Fort Mill we are typically on site in 25 to 35 minutes, and our goal is 60 minutes or less anywhere else in our service area." },
  { title: "We Inspect and Map the Moisture", text: "Our technicians use thermal cameras and moisture meters to find every wet area, even behind walls and under floors. We document everything from the start.", caption: "FLIR thermal imaging &mdash; we pinpoint hidden moisture other companies miss", image: imgThermal, imageAlt: "FLIR thermal imaging camera used by Carolina Pro Restoration to detect hidden moisture during a water damage inspection" },
  { title: "Water Removal and Structural Drying", text: "We pull the water out fast with commercial extractors, then place air movers and dehumidifiers to dry the structure. We treat surfaces with antimicrobial solution to stop mold before it starts." },
  { title: "Daily Moisture Checks and Documentation", text: "We log everything with photos and moisture readings your insurance company needs to process the claim. You get updates every step of the way." },
  { title: "Full Rebuild and Final Walkthrough", text: "We rebuild drywall, paint, trim, cabinets, and flooring. The same project manager stays with your job until the final walkthrough is done and you are happy with the result." },
];

const damageTimeline = [
  { badge: "In Minutes", title: "Water Spreads Fast", text: "Water soaks into carpet, furniture, and walls. It wicks up drywall like a sponge and ruins paint and baseboards right away." },
  { badge: "Within 24 Hours", title: "Floors Start to Buckle", text: "Drywall gets soft and falls apart. Wood floors warp and cup. A musty smell fills the house as materials start to break down." },
  { badge: "Within 48 Hours", title: "Mold Starts Growing", text: "Mold grows behind walls and under floors. The air becomes unhealthy to breathe. Cleanup costs go up fast at this point." },
  { badge: "In 25–35 Minutes", title: "We Are at Your Door", text: "Our Fort Mill crew arrives with truck-mounted extractors, dehumidifiers, and thermal cameras to stop the damage before it spreads.", resolve: true },
];

const insurancePoints = [
  "We take all the damage photos",
  "We send daily moisture reports",
  "We write the estimate in Xactimate",
  "We talk to the adjuster for you",
  "We bill them directly, so you pay your deductible and nothing beyond it",
];

// The Fort Mill Service node the retired city page carried, now on /.
const origin = Astro.site!.toString().replace(/\/$/, "");
const schema = [
  {
    "@type": "Service",
    "@id": `${origin}/#service`,
    serviceType: "Water Damage Restoration",
    name: "Water Damage Restoration in Fort Mill, SC",
    url: `${origin}/`,
    description: homepage.metaDescription,
    provider: { "@id": `${origin}/#business` },
    areaServed: { "@type": "City", name: "Fort Mill, SC" },
    mainEntityOfPage: { "@id": `${origin}/#webpage` },
  },
  {
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
    })),
  },
];
---

<BaseLayout title={homepage.title} description={homepage.metaDescription} path="/" schema={schema} reviews={featuredReviews} preloadImage={heroPreload(heroImg)}>
  <Hero
    emergencyTag="🚨 24/7 Emergency Dispatch — Fort Mill"
    h1Lines={homepage.h1Lines}
    subtitle="Standing in water? Crews dispatch from our Fort Mill shop across York and Lancaster counties, and we're on site in 25–35 minutes anywhere in Fort Mill. Unlike 'tear-out only' franchises, we stop the damage and handle the entire rebuild with one dedicated team. We bill your insurance directly."
    trustSignals={["Top-Rated in Fort Mill", "25-35 Min Response", "Licensed, Insured & IICRC", "Direct Insurance Billing"]}
    image={heroImg}
    imageAlt="Carolina Pro Restoration branded truck and water-proofing van at the Fort Mill office"
    secondaryCta={{ label: "Request Inspection", href: "#contact" }}
  />
  <UrgencyBand />
  <LocalContent blocks={fortMillIntro} />
  <Neighborhoods
    city="Fort Mill"
    intro="We respond to water damage calls across all of Fort Mill, including:"
    neighborhoods={fortMillNeighborhoods}
    viewAllLabel="View every town we serve across York and Lancaster counties"
  />
  <Timeline
    title="What Waiting Costs You"
    sub="Water damage is a chain reaction. The longer it sits, the more of your home it takes."
    ctaLabel="The faster we start, the more we save. Call now — we're here 24/7."
    cards={damageTimeline}
  />
  <ProcessSteps
    title="What to Expect from Start to Finish"
    sub="One project manager handles your entire job. Here is how it works from the first call to the final walkthrough."
    steps={processSteps}
    ctaLabel="One team. One project manager. One phone call."
  />
  <LocalContent blocks={fortMillProblems} light={true} />
  <ServicesGrid />
  <Reviews
    title="What Our Customers Say"
    sub="Real reviews from homeowners, property managers, and HOAs in Fort Mill, Tega Cay, and across York County."
  />
  <Differentiators
    title="Why Homeowners Choose CPR Over the Competition"
    sub="Most companies rip out your wet drywall and leave you to find your own painters, carpenters, and flooring guys. With CPR, you make one phone call and deal with one project manager. We handle everything."
  />
  <ActionShot
    image={imgCrew}
    alt="Carolina Pro Restoration technician beside a company van in Fort Mill, SC"
    eyebrow="Locally owned, Fort Mill based"
    heading="One local crew — from the first call to the final coat of paint"
    text="We answer our own phone 24/7 and dispatch our own IICRC-certified technicians. Water removal, drying, mold, and the full rebuild — all handled by one team. No franchise call center, no subcontractor runaround."
    flip={true}
  />
  <InsuranceCard
    title="We Handle Your Insurance"
    desc="We use Xactimate, the same software your insurance company uses, so there are no surprises and no delays on your claim."
    points={insurancePoints}
  />
  <Faq
    title="Fort Mill Water Damage FAQs"
    sub="Clear answers for homeowners in Fort Mill, Tega Cay, and across York and Lancaster counties."
    items={faq}
  />
  <ServiceArea
    title="Locally Owned in Fort Mill. Serving York & Lancaster Counties."
    sub="We are not a distant call center. Our shop is at 3650 Centre Circle in Fort Mill, just south of Charlotte, with crews across York and Lancaster counties and the neighboring North Carolina towns."
    infoHeading="Fast Response From Fort Mill"
    infoBlurb="Our trucks reach all of Fort Mill and surrounding cities in under 35 minutes, and the rest of York County in under an hour."
    cities={homeCities}
  />
  <FinalCta heading="Water Damage in Fort Mill Right Now? We Are Ready." secondaryLabel={waterCta.assessment} />
  <ContactForm
    heading="Request a Fort Mill Inspection"
    cardTitle={waterCta.assessment}
    cardSub={waterCta.cardSub}
    description="Fill out this short form and our Fort Mill crew will call you back fast. For emergencies, call us directly — we pick up 24/7."
    trustItems={[
      "No cost for the on-site inspection",
      "We respond to form requests within 30 minutes",
      "No pressure, no obligation",
      "We bring all the equipment on the first visit",
      "Safe practices for families and pets",
    ]}
    formName="HomePage Short Contact"
  />
</BaseLayout>
